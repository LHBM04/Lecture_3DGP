      <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$src = '%(FullPath)'; $outDir = '$(OutDir)Resources\Shaders'; $dxc = '$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe'; New-Item -ItemType Directory -Force -Path $outDir | Out-Null; $stages = @{ vertex = @{ profile = 'vs_6_0'; ext = 'vert' }; pixel = @{ profile = 'ps_6_0'; ext = 'frag' } }; $meta = @(); Get-Content $src | ForEach-Object { if ($_ -match '^#pragma\s+(vertex|pixel)\s+(\S+)') { $s = $stages[$Matches[1]]; &amp; $dxc -nologo -T $s.profile -E $Matches[2] $src -Fo (Join-Path $outDir ('%(Filename).' + $s.ext + '.cso')); if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE } } elseif ($_ -match '^\s*//\s*@(\w+)\s+(\S+)') { $meta += ($Matches[1] + '=' + $Matches[2]) } }; [System.IO.File]::WriteAllLines((Join-Path $outDir ('%(Filename).meta')), [string[]]$meta, [System.Text.UTF8Encoding]::new($false))"</Command>
      <Message>Compiling %(Filename)%(Extension)</Message>
      <Outputs>$(OutDir)Resources\Shaders\%(Filename).vert.cso;$(OutDir)Resources\Shaders\%(Filename).frag.cso;$(OutDir)Resources\Shaders\%(Filename).meta</Outputs>
